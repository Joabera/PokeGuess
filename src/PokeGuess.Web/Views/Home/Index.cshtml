@{
    ViewData["Title"] = "Guess";
}

<div class="guess-page">
    <p class="text-muted mb-3">Drop, paste, or snap a Pokémon (Gen 1–9). Photos, art, and sketches all work.</p>

    <div id="drop" tabindex="0" role="button" aria-label="Choose an image">
        <p><strong>Drag &amp; drop</strong> an image here</p>
        <p class="d-none d-sm-block">or paste from clipboard (Ctrl/Cmd + V)</p>
        <div class="d-flex gap-2 justify-content-center mt-2">
            <button class="btn btn-accent" type="button" id="pickBtn">Select image</button>
            <button class="btn btn-outline-accent d-none" type="button" id="cameraBtn">Use camera</button>
        </div>
        <input type="file" id="fileInput" accept="image/*" hidden />
        <input type="file" id="cameraInput" accept="image/*" capture="environment" hidden />
        <img id="preview" alt="Your image" />
    </div>

    <div id="status" class="mt-3" role="status" aria-live="polite"></div>

    <partial name="_ResultPanel" />
</div>

@section Scripts {
    <script type="module" src="~/js/guess.js" asp-append-version="true"></script>
}
