@inject PokeGuess.Web.Services.Pokedex Dex
@{
    ViewData["Title"] = "Guess";
}

<div class="guess-page">
    <p class="text-muted mb-3">Drop, paste, or snap a Pokémon (Gen 1–3). Photos, art, and sketches all work.</p>

    <div id="drop" tabindex="0" role="button" aria-label="Choose an image">
        <p><strong>Drag &amp; drop</strong> an image here</p>
        <p class="d-none d-sm-block">or paste from clipboard (Ctrl/Cmd + V)</p>
        <div class="d-flex gap-2 justify-content-center mt-2">
            <button class="btn btn-accent" type="button" id="pickBtn">Select image</button>
            <button class="btn btn-outline-accent d-none" type="button" id="cameraBtn">Use camera</button>
        </div>
        <input type="file" id="fileInput" accept="image/*" hidden />
        <input type="file" id="cameraInput" accept="image/*" capture="environment" hidden />
        <img id="preview" alt="Your image" />
    </div>

    <div id="status" class="mt-3" role="status" aria-live="polite"></div>

    <div id="verdict" class="text-center mt-3 d-none">
        <img id="sprite" class="d-none" alt="" />
        <div class="winner" id="winner"></div>
        <span class="badge text-bg-secondary model-badge" id="modelBadge"></span>
        <div><button class="btn btn-sm btn-outline-accent mt-2 d-none" type="button" id="cryBtn">🔊 Play cry</button></div>
        <div class="digimon mt-2 d-none" id="digimon"></div>
    </div>

    <div id="results" class="mt-3"></div>

    <div id="feedback" class="mt-3 d-none">
        <p class="mb-2">Did we get it right?</p>
        <div class="d-flex gap-2">
            <button class="btn btn-success flex-fill" type="button" id="yesBtn">✓ Correct</button>
            <button class="btn btn-outline-danger flex-fill" type="button" id="noBtn">✗ Wrong</button>
        </div>
        <form id="actualForm" class="d-flex gap-2 mt-2 d-none">
            <label for="actualName" class="visually-hidden">Which Pokémon is it?</label>
            <input class="form-control" id="actualName" list="pokemon-names" placeholder="Which Pokémon is it?" autocomplete="off" required />
            <button class="btn btn-accent" type="submit">Submit</button>
        </form>
        <div id="feedbackMsg" class="mt-2 text-muted" aria-live="polite"></div>
    </div>

    <datalist id="pokemon-names">
        @foreach (var name in Dex.Names)
        {
            <option value="@name"></option>
        }
    </datalist>
</div>

<audio id="cry"></audio>

@section Scripts {
    <script>window.POKEAPI_SLUGS = @Json.Serialize(Dex.Slugs);</script>
    <script src="~/js/guess.js" asp-append-version="true"></script>
}
